[Desktop Entry]
Type=Application
Name=Weather Kiosk
Exec=/bin/bash -c "sleep 5; until curl -s http://127.0.0.1:5000/weather > /dev/null; do sleep 1; done; sleep 2; /usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disable-gpu --password-store=basic http://127.0.0.1:5000/weather"
Terminal=false
X-GNOME-Autostart-enabled=true